<Window x:Class="GemmaLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GemmaLauncher.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Text ui.app.title}" Width="1160" Height="960" MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AutomationProperties.Name="{loc:Text ui.app.title}" Style="{StaticResource {x:Type Window}}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD6C6" BorderThickness="1" Background="{StaticResource PaperBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid Margin="30,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,18,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="39" Height="39" Background="{StaticResource InkBrush}" CornerRadius="10" Margin="0,0,12,0">
                            <Path Data="M 4 13 L 13 4 L 22 13 L 13 22 Z M 7 13 L 13 7 L 19 13 L 13 19 Z" Stroke="#EDF0CE" StrokeThickness="1.25" Width="26" Height="26" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text ui.app.title}" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="by Drugged Cat" FontSize="13" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </Grid>
                            <TextBlock Text="{loc:Text ui.app.subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding LanguageSelection, Mode=TwoWay}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="190" MinHeight="34" MaxHeight="56" Margin="0,0,14,0" AutomationProperties.Name="{loc:Text ui.language.label}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                        <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{loc:Text ui.window.minimize}" AutomationProperties.Name="{loc:Text ui.window.minimize}" />
                        <Button Content="&#xE922;" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="{loc:Text ui.window.resize}" AutomationProperties.Name="{loc:Text ui.window.resize}" />
                        <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Click="Hide_Click" ToolTip="{loc:Text ui.window.hideHint}" AutomationProperties.Name="{loc:Text ui.window.hide}" />
                    </StackPanel>
                </Grid>
            </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.17*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="32,27,26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{loc:Text ui.model.browse}" Style="{StaticResource TextButton}" Margin="0,-7,-5,-5" Command="{Binding ManageModelsCommand}" AutomationProperties.Name="{loc:Text ui.model.browse}" />
                            <TextBlock Text="{loc:Text ui.model.choose}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectModel}" Margin="0,10,0,0" AutomationProperties.Name="{loc:Text ui.model.choose}" FontWeight="SemiBold" Background="#F1F5EC" />
                        <TextBlock Text="{Binding SelectedPresentation.Category}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,18,0,5" />
                        <TextBlock Text="{Binding SelectedPresentation.Headline}" FontSize="24" FontWeight="SemiBold" LineHeight="33" />
                        <TextBlock Text="{Binding SelectedPresentation.Description}" Style="{StaticResource BodyText}" Margin="0,7,0,0" />
                        <ItemsControl ItemsSource="{Binding SelectedPresentation.Benefits}" Margin="0,13,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" LineHeight="22" Foreground="#47643E" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource SoftBrush}" CornerRadius="6" Padding="11,9" Margin="0,5,0,0">
                            <TextBlock Text="{Binding SelectedPresentation.HardwareGuide}" Foreground="#3D6034" LineHeight="21" />
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Text ui.manager.memory}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding SelectedPresentation.MemoryGuide}" LineHeight="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Text ui.model.download}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding SelectedModel.DownloadLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,0,6,0">
                        <StackPanel Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,5" />
                            <TextBlock Text="{Binding StatusDescription}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0">
                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" AutomationProperties.Name="{loc:Text ui.progress.name}" />
                        </StackPanel>
                        <Button Content="{loc:Text ui.runtime.install}" Command="{Binding InstallPrerequisiteCommand}" Visibility="{Binding NeedsRuntimePrerequisite, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" />
                        <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding StatusNote}" Foreground="{StaticResource MutedBrush}" LineHeight="21" TextAlignment="Center" Margin="3,8,3,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,22,26,18">
                        <StackPanel>
                            <TextBlock Text="{loc:Text ui.settings.title}" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text ui.context.label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding SelectedContext, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding CanChangeContext}" AutomationProperties.Name="{loc:Text ui.context.label}" />
                            </Grid>
                            <TextBlock Text="{Binding ContextHint}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                            <Border Background="#E5EDDA" CornerRadius="6" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding HasPendingContext, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text ui.context.pending}" LineHeight="22" Foreground="#3D6034" />
                                    <Button Content="{loc:Text ui.context.restart}" Command="{Binding RestartCommand}" HorizontalAlignment="Left" Style="{StaticResource TextButton}" Margin="-5,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#D5DFCF" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Text ui.connection.title}" Style="{StaticResource SectionLabel}" />
                                    </DockPanel>
                                    <TextBlock Text="{loc:Text ui.connection.api}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6" />
                                    <Border Background="{StaticResource PaperBrush}" BorderBrush="#CCD8C4" BorderThickness="1" CornerRadius="7" Padding="11,5,5,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ApiAddress, Mode=OneWay}" Style="{StaticResource ReadOnlyField}" AutomationProperties.Name="{loc:Text ui.connection.api}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource TextButton}" Command="{Binding CopyApiCommand}" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{loc:Text ui.connection.copy}" AutomationProperties.Name="{loc:Text ui.connection.copy}" Width="34" Height="32" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{loc:Text ui.connection.model}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding ApiModelId, Mode=OneWay}" Style="{StaticResource ReadOnlyField}" Foreground="#566B4C" AutomationProperties.Name="{loc:Text ui.connection.apiModel}" />
                                    <Button Command="{Binding OpenWebUiCommand}" IsEnabled="{Binding CanOpenWebUi}" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,8,0" />
                                            <TextBlock Text="{loc:Text ui.connection.web}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{loc:Text ui.connection.hint}" Style="{StaticResource BodyText}" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#D5DFCF" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding MemoryUsageLabel}" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding MemoryUsage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" LineHeight="23" Margin="0,8,0,0" AutomationProperties.LiveSetting="Off" />
                                    <TextBlock Text="{loc:Text ui.memory.hint}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Expander Header="{loc:Text ui.files.title}" IsExpanded="True" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" FontSize="13">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Text ui.files.hint}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                                    <WrapPanel Margin="-5,0,0,0">
                                        <Button Content="{loc:Text ui.files.connect}" Command="{Binding ConnectModelFileCommand}" Style="{StaticResource PrimaryButton}" FontSize="13" MinHeight="30" Padding="8,5" Margin="5,0,7,4" ToolTip="{loc:Text ui.picker.gguf}" />
                                        <Button Content="{loc:Text ui.files.find}" Command="{Binding ChooseModelFolderCommand}" Style="{StaticResource TextButton}" Margin="0,0,7,4" />
                                        <Button Content="{loc:Text ui.files.folder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource TextButton}" Margin="0,0,7,4" />
                                        <Button Content="{loc:Text ui.files.info}" Command="{Binding OpenModelSourceCommand}" Style="{StaticResource TextButton}" Margin="0,0,7,4" />
                                        <Button Content="{loc:Text ui.files.logs}" Command="{Binding OpenLogsCommand}" Style="{StaticResource TextButton}" Margin="0,0,7,4" />
                                        <Expander Header="{loc:Text ui.files.advanced}" IsExpanded="False" Margin="6,4,0,4">
                                            <Button Content="{loc:Text ui.files.catalog}" Command="{Binding ImportCatalogCommand}" Style="{StaticResource TextButton}" ToolTip="{loc:Text ui.manager.addHint}" Margin="0,4,0,0" />
                                        </Expander>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            <Border Grid.Row="2" Padding="30,11" Background="#EDF3E5" BorderBrush="#D6E1CC" BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="31" Height="31" CornerRadius="7" Background="#DEEACA" Margin="0,0,11,0">
                        <Path Data="M 10 0 L 2 10 L 8 10 L 6 19 L 16 7 L 10 7 Z" Stroke="#46652E" StrokeThickness="1.25" Width="17" Height="20" Stretch="Uniform" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding AccelerationLabel}" FontWeight="SemiBold" Foreground="#3D6034" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:Text ui.acceleration.hint}" Foreground="#536D42" VerticalAlignment="Center" Margin="18,0,0,0" />
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="30,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Text ui.footer.background}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="{loc:Text ui.footer.exit}" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
