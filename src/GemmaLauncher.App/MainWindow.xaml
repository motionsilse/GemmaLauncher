<Window x:Class="GemmaLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GemmaLauncher.App.Localization" xmlns:local="clr-namespace:GemmaLauncher.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Text ui.app.title}" Width="1160" Height="960" MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AutomationProperties.Name="{loc:Text ui.app.title}" Style="{StaticResource {x:Type Window}}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD6C6" BorderThickness="1" Background="{StaticResource PaperBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid Margin="30,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,18,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="39" Height="39" Background="{StaticResource InkBrush}" CornerRadius="10" Margin="0,0,12,0">
                            <Path Data="M 4 13 L 13 4 L 22 13 L 13 22 Z M 7 13 L 13 7 L 19 13 L 13 19 Z" Stroke="#EDF0CE" StrokeThickness="1.25" Width="26" Height="26" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text ui.app.title}" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="by Drugged Cat" FontSize="13" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </Grid>
                            <TextBlock Text="{loc:Text ui.app.subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding LanguageSelection, Mode=TwoWay}" SelectedValuePath="Code" DisplayMemberPath="Name" Width="190" MinHeight="34" MaxHeight="56" Margin="0,0,14,0" AutomationProperties.Name="{loc:Text ui.language.label}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                        <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{loc:Text ui.window.minimize}" AutomationProperties.Name="{loc:Text ui.window.minimize}" />
                        <Button Content="&#xE922;" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="{loc:Text ui.window.resize}" AutomationProperties.Name="{loc:Text ui.window.resize}" />
                        <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Click="Hide_Click" ToolTip="{loc:Text ui.window.hideHint}" AutomationProperties.Name="{loc:Text ui.window.hide}" />
                    </StackPanel>
                </Grid>
            </Border>

            <local:LauncherWorkspace x:Name="Workspace" Grid.Row="1" />
            <Grid Grid.Row="3" Margin="30,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Text ui.footer.background}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="{loc:Text ui.footer.exit}" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
