<UserControl x:Class="GemmaLauncher.App.LauncherWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GemmaLauncher.App.Localization" xmlns:local="clr-namespace:GemmaLauncher.App">
 <Grid Margin="28,16,28,0">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TabControl Style="{StaticResource NavigationTabs}" SelectedIndex="{Binding PageIndex, Mode=TwoWay}">
   <TabItem Header="{loc:Text ui.library.run}">
    <Grid>
    <StackPanel Visibility="{Binding ShowRunEmpty, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
     <TextBlock Text="{loc:Text ui.library.emptyTitle}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
     <TextBlock Text="{loc:Text ui.library.emptyHint}" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,12,0,20" />
     <Button Content="{loc:Text ui.model.browse}" Command="{Binding ManageModelsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="24,10" />
    </StackPanel>
    <Grid Visibility="{Binding HasSelectedModel, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
      <StackPanel>
       <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text ui.model.browse}" Command="{Binding ManageModelsCommand}" Style="{StaticResource TextButton}" /><TextBlock Text="{loc:Text ui.model.choose}" VerticalAlignment="Center" Style="{StaticResource SectionLabel}" /></DockPanel>
       <ComboBox x:Name="RunModelSelector" ItemsSource="{Binding LibraryModels}" SelectedValuePath="Definition" SelectedValue="{Binding SelectedModel, Mode=TwoWay}" IsEnabled="{Binding CanSelectModel}" Margin="0,8,0,0" AutomationProperties.Name="{loc:Text ui.model.choose}">
        <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding FileStateLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <TextBlock Text="{loc:Text ui.library.taskPreset}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
       <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangePreset}" AutomationProperties.Name="{loc:Text ui.library.taskPreset}" />
       <TextBlock Text="{loc:Text ui.library.presetScope}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
       <TextBlock Text="{loc:Text ui.context.label}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
       <ComboBox ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding SelectedContext, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding CanChangeContext}" AutomationProperties.Name="{loc:Text ui.context.label}" />
       <TextBlock Text="{Binding ContextHint}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
       <Button Content="{loc:Text ui.context.restart}" Command="{Binding RestartCommand}" Visibility="{Binding HasPendingContext, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0" />
       <Expander Header="{loc:Text ui.library.advanced}" Margin="0,22,0,0">
        <StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanSelectModel}">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{loc:Text ui.library.gpuLayers}" /><ComboBox ItemsSource="{Binding GpuLayerChoices}" SelectedItem="{Binding GpuLayers, Mode=TwoWay}" Margin="0,6,0,0" AutomationProperties.Name="{loc:Text ui.library.gpuLayers}" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{loc:Text ui.library.cache}" /><ComboBox ItemsSource="{Binding CacheChoices}" SelectedItem="{Binding CacheType, Mode=TwoWay}" Margin="0,6,0,0" AutomationProperties.Name="{loc:Text ui.library.cache}" /></StackPanel>
         </Grid>
         <TextBlock Text="{loc:Text ui.library.gpuHint}" Style="{StaticResource BodyText}" Margin="0,7,0,10" />
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Flash Attention" /><ComboBox ItemsSource="{Binding ToggleChoices}" SelectedItem="{Binding FlashAttention, Mode=TwoWay}" Margin="0,6,0,0" AutomationProperties.Name="Flash Attention" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{loc:Text ui.library.reasoning}" /><ComboBox ItemsSource="{Binding ToggleChoices}" SelectedItem="{Binding Reasoning, Mode=TwoWay}" Margin="0,6,0,0" AutomationProperties.Name="{loc:Text ui.library.reasoning}" /></StackPanel>
         </Grid>
         <TextBlock Text="{Binding MtpLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,8" />
         <StackPanel Visibility="{Binding HasMtp, Converter={StaticResource BoolVisibility}}">
          <CheckBox IsChecked="{Binding UseMtp, Mode=TwoWay}" Content="{loc:Text ui.library.useMtp}" />
          <TextBlock Text="{loc:Text ui.library.draftTokens}" Margin="0,10,0,4" /><TextBox Text="{Binding DraftTokens, Mode=TwoWay}" Style="{StaticResource FormField}" AutomationProperties.Name="{loc:Text ui.library.draftTokens}" />
         </StackPanel>
         <Button Content="{loc:Text ui.library.connectMtp}" Command="{Binding ConnectMtpCommand}" Margin="0,10,0,0" />
         <TextBlock Text="{Binding TemplateHint}" Style="{StaticResource BodyText}" Margin="0,16,0,5" />
         <TextBox Text="{Binding ChatTemplate, Mode=TwoWay}" Style="{StaticResource FormField}" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Text ui.library.template}" />
         <Button Content="{loc:Text ui.library.resetOptions}" Command="{Binding ResetLoadOptionsCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Column="2" Padding="22" CornerRadius="9" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionLabel}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{loc:Text ui.connection.title}" FontWeight="SemiBold" /></DockPanel>
       <TextBlock Text="{loc:Text ui.connection.api}" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,8" />
       <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text ui.connection.copy}" Command="{Binding CopyApiCommand}" Style="{StaticResource TextButton}" /><TextBox Text="{Binding ApiAddress, Mode=OneWay}" Style="{StaticResource ReadOnlyField}" AutomationProperties.Name="{loc:Text ui.connection.api}" /></DockPanel>
       <TextBlock Text="{loc:Text ui.connection.model}" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,8" /><TextBox Text="{Binding ApiModelId, Mode=OneWay}" Style="{StaticResource ReadOnlyField}" AutomationProperties.Name="{loc:Text ui.connection.apiModel}" />
       <Button Content="{loc:Text ui.connection.web}" Command="{Binding OpenWebUiCommand}" Margin="0,20,0,0" />
       <TextBlock Text="{loc:Text ui.connection.hint}" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
       <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0"><StackPanel>
        <TextBlock Text="{Binding MemoryUsageLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding MemoryUsage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock Text="{loc:Text ui.memory.hint}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
       </StackPanel></Border>
       <WrapPanel Margin="0,14,0,0"><Button Content="{loc:Text ui.files.logs}" Command="{Binding OpenLogsCommand}" Style="{StaticResource TextButton}" /><Button Content="{loc:Text ui.files.folder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource TextButton}" /></WrapPanel>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="{loc:Text ui.library.models}"><local:ModelLibraryView /></TabItem>
   <TabItem Header="{loc:Text ui.library.presets}"><local:PresetEditorView /></TabItem>
  </TabControl>
  <Border Grid.Row="1" Visibility="{Binding ShowOperation, Converter={StaticResource BoolVisibility}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
    <StackPanel AutomationProperties.LiveSetting="Polite">
     <TextBlock Text="{Binding SelectedModel.DisplayName}" Visibility="{Binding ShowOperationModel, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
     <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,4" />
     <TextBlock Text="{Binding StatusDescription}" Style="{StaticResource BodyText}" />
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
     <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10" AutomationProperties.Name="{loc:Text ui.progress.name}" />
     <Button Content="{loc:Text ui.runtime.install}" Command="{Binding InstallPrerequisiteCommand}" Visibility="{Binding NeedsRuntimePrerequisite, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" />
     <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolVisibility}}" />
    </StackPanel>
   </Grid>
  </Border>
  <TextBlock Grid.Row="2" Text="{Binding StatusNote}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" MaxHeight="70" AutomationProperties.LiveSetting="Polite">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,12" /><Style.Triggers><DataTrigger Binding="{Binding StatusNote}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </Grid>
</UserControl>
