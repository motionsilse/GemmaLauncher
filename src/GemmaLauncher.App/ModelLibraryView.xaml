<UserControl x:Class="GemmaLauncher.App.ModelLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GemmaLauncher.App.Localization">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="{loc:Text ui.files.add}" Command="{Binding AddModelCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8" /><StackPanel><TextBlock Text="{loc:Text ui.library.headline}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{loc:Text ui.library.description}" Style="{StaticResource BodyText}" Margin="0,4,15,0" /></StackPanel></DockPanel>
  <TabControl Grid.Row="1" Style="{StaticResource NavigationTabs}" SelectedIndex="{Binding ModelPageIndex, Mode=TwoWay}">
   <TabItem Header="{loc:Text ui.library.recommended}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
     <ItemsControl ItemsSource="{Binding Families}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,12" Background="{StaticResource PaperBrush}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="225" /></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
         <TextBlock Text="{Binding Selected.Credit}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
         <TextBlock Text="{Binding Selected.Headline}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,3" />
         <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource BodyText}" MaxHeight="46" TextTrimming="WordEllipsis" ToolTip="{Binding Selected.Description}" />
         <Expander Header="{loc:Text ui.files.info}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0">
          <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding Selected.HardwareGuide}" TextWrapping="Wrap" /><TextBlock Text="{Binding Selected.MemoryGuide}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,7" /><ItemsControl ItemsSource="{Binding Selected.Benefits}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
         </Expander>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
         <ListBox ItemsSource="{Binding Variants}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Variant" Visibility="{Binding HasVariants, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Name}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
           <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,0,5,0" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Option" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource PaperBrush}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border><ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource SoftBrush}" /><Setter TargetName="Option" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource SoftBrush}" /></Trigger>
           </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
         </ListBox>
         <TextBlock Margin="0,9,0,8" Foreground="{StaticResource MutedBrush}"><Run Text="{loc:Text ui.model.download}" /><Run Text=" · " /><Run Text="{Binding Selected.DownloadLabel, Mode=OneWay}" /></TextBlock>
         <Button Content="{loc:Text ui.library.use}" Command="{Binding DataContext.UseLibraryModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Selected}" />
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{loc:Text ui.library.mine}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="{loc:Text ui.library.mineHint}" Style="{StaticResource BodyText}" Margin="0,0,0,12" />
     <StackPanel Grid.Row="1" Visibility="{Binding ShowLibraryEmpty, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
      <TextBlock Text="{loc:Text ui.library.emptyTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBlock Text="{loc:Text ui.library.emptyHint}" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,12,0,16" />
      <Button Content="{loc:Text ui.model.browse}" Command="{Binding ManageModelsCommand}" HorizontalAlignment="Center" />
     </StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding LibraryModels}" Visibility="{Binding HasLibraryModels, Converter={StaticResource BoolVisibility}}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource InkBrush}" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{loc:Text ui.library.mine}">
      <ListBox.ItemTemplate><DataTemplate><Border Padding="0,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,15,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding FileStateLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding Definition.Artifacts[0].Filename}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{loc:Text ui.library.use}" Command="{Binding DataContext.UseLibraryModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /><Button Content="{loc:Text ui.library.remove}" Command="{Binding DataContext.RemoveLibraryModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsUserModel, Converter={StaticResource BoolVisibility}}" Style="{StaticResource TextButton}" Margin="8,0,0,0" /></StackPanel>
      </Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="{loc:Text ui.files.find}" Command="{Binding ChooseModelFolderCommand}" Style="{StaticResource TextButton}" /><Button Content="{loc:Text ui.files.folder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource TextButton}" /></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="{loc:Text ui.files.add}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border Padding="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9"><StackPanel>
      <TextBlock Text="{loc:Text ui.library.localGguf}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{loc:Text ui.library.localHint}" Style="{StaticResource BodyText}" Margin="0,7,0,12" />
      <Button Content="{loc:Text ui.files.connect}" Command="{Binding ConnectModelFileCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,9" />
     </StackPanel></Border>
     <Border Padding="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Margin="0,16,0,0"><StackPanel>
      <TextBlock Text="Hugging Face" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{loc:Text ui.library.hfHint}" Style="{StaticResource BodyText}" Margin="0,7,0,12" />
      <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text ui.library.findFiles}" Command="{Binding FindHuggingFaceCommand}" Margin="12,0,0,0" /><TextBox Text="{Binding HuggingFaceAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelectModel}" Style="{StaticResource FormField}" AutomationProperties.Name="Hugging Face URL" /></DockPanel>
      <StackPanel Visibility="{Binding HasHuggingFaceFiles, Converter={StaticResource BoolVisibility}}" Margin="0,15,0,0"><TextBlock Text="{loc:Text ui.library.downloadFile}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding HuggingFaceFiles}" SelectedItem="{Binding SelectedHuggingFaceFile, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectModel}" AutomationProperties.Name="{loc:Text ui.library.downloadFile}" /><Button Content="{loc:Text ui.library.register}" Command="{Binding AddHuggingFaceCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" /></StackPanel>
     </StackPanel></Border>
     <Expander Header="{loc:Text ui.files.advanced}" Margin="0,18,0,0"><Button Content="{loc:Text ui.files.catalog}" Command="{Binding ImportCatalogCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,10,0,0" /></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
