<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CatLoader</AssemblyName>
    <Version>0.1.0</Version>
    <HuggingFaceClientId Condition="'$(HuggingFaceClientId)' == ''">b5a9b43f-5d3d-4379-b729-e9033aee4c88</HuggingFaceClientId>
    <StartupObject>GemmaLauncher.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/launcher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../GemmaLauncher.Core/GemmaLauncher.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(HuggingFaceClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HuggingFaceClientId</_Parameter1>
      <_Parameter2>$(HuggingFaceClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/catalog.json" WithCulture="false" LogicalName="GemmaLauncher.Catalog.json" />
    <EmbeddedResource Include="$(LauncherNoticesFile)" Condition="'$(LauncherNoticesFile)' != ''" WithCulture="false" LogicalName="GemmaLauncher.Notices.txt" />
    <EmbeddedResource Include="../../LICENSE" Condition="'$(LauncherNoticesFile)' == '' and Exists('../../LICENSE')" WithCulture="false" LogicalName="GemmaLauncher.License.txt" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" Condition="'$(LauncherNoticesFile)' == ''" WithCulture="false" LogicalName="GemmaLauncher.ThirdPartyNotices.txt" />
  </ItemGroup>
  <Target Name="RequireBundledNoticesForSingleFile" BeforeTargets="PrepareForBuild" Condition="'$(PublishSingleFile)' == 'true' and '$(LauncherNoticesFile)' == ''">
    <Error Text="Single-file publishing requires bundled license notices. Use scripts/publish-launcher.ps1." />
  </Target>
</Project>
